{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "prisma:generate": {
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
