{
  "name": "galatura-factory-management",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:check": "node tools/prisma/check-migrations.mjs",
    "prisma:check:static": "node tools/prisma/check-migrations.mjs --static",
    "test:tools": "node --test tools/benchmark/lib.test.mjs tools/clientgen/lib.test.mjs tools/data-migration/lib.test.mjs tools/load/lib.test.mjs tools/openapi/lib.test.mjs tools/recovery/verify-backup-manifest.test.mjs tools/security/check-security.test.mjs",
    "openapi:generate": "node tools/openapi/generate.mjs --root .",
    "openapi:check": "node tools/openapi/generate.mjs --root . --check && node tools/openapi/validate-specs.mjs --root .",
    "client:generate": "node tools/clientgen/generate.mjs --root .",
    "client:check": "node tools/clientgen/generate.mjs --root . --check",
    "face:benchmark": "node tools/benchmark/benchmark.mjs",
    "accounts:integrity": "pnpm --filter @galatura/accounts-service integrity:nightly",
    "db:smoke": "node tools/db/smoke.mjs",
    "security:check": "node tools/security/check-security.mjs --root . --strict",
    "security:audit": "pnpm audit --audit-level high",
    "load:validate": "node tools/load/load-test.mjs --scenario tools/load/scenarios/weighing-peak.json --dry-run && node tools/load/load-test.mjs --scenario tools/load/scenarios/sync-burst.json --dry-run",
    "migration:validate": "node tools/data-migration/migrate.mjs --manifest tools/data-migration/migration.example.json --validate",
    "migration:dry-run": "node tools/data-migration/migrate.mjs --manifest tools/data-migration/migration.example.json --dry-run",
    "dr:check": "node tools/recovery/verify-backup-manifest.mjs --strict"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
