# Environment Variables Template
# Copy this file to .env and fill in your Supabase database password.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.mkwasmqlwkavodvjcgwu:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.mkwasmqlwkavodvjcgwu:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: Dedicated role connection string for identity-service (after running infra/supabase/provision-schemas.sql)
# IDENTITY_DATABASE_URL="postgresql://identity_service.mkwasmqlwkavodvjcgwu:[IDENTITY-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# IDENTITY_DIRECT_URL="postgresql://identity_service.mkwasmqlwkavodvjcgwu:[IDENTITY-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Redis Cache / Rate Limiting (optional in dev; falls back to in-memory)
# REDIS_URL="redis://localhost:6379"

# Platform Master Key (32-byte hex for AES-256-GCM encryption of sensitive data like TOTP secrets)
PLATFORM_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Service Ports
PORT=3000
IDENTITY_SERVICE_URL="http://localhost:3001"
