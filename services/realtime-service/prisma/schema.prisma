generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["realtime"]
}

model RealtimeConnection {
  id             String    @id @default(uuid(7)) @db.Uuid
  clientApp      String    @db.Text
  principalId    String?   @map("principal_id") @db.Text
  channels       Json
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(6)

  @@index([principalId])
  @@map("realtime_connections")
  @@schema("realtime")
}

model RealtimeEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  channel           String   @db.Text
  eventType         String   @map("event_type") @db.Text
  payload           Json
  requiredPermission String  @map("required_permission") @db.Text
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([channel, createdAt])
  @@index([expiresAt])
  @@map("realtime_events")
  @@schema("realtime")
}

model WebhookSubscription {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.Text
  targetUrl  String   @map("target_url") @db.Text
  eventTypes Json     @map("event_types")
  secretEnc  Bytes    @map("secret_enc")
  active     Boolean  @default(true)
  createdBy  String?  @map("created_by") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active])
  @@map("webhook_subscriptions")
  @@schema("realtime")
}

model WebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  attempt        Int
  status         String    @db.Text
  responseCode   Int?      @map("response_code")
  error          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)

  @@index([subscriptionId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
  @@schema("realtime")
}

model ProcessedEvent {
  id          String   @id @db.Uuid
  consumer    String   @db.Text
  type        String   @db.Text
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@unique([consumer, id])
  @@index([processedAt])
  @@map("processed_events")
  @@schema("realtime")
}

model PushToken {
  id          String   @id @default(uuid(7)) @db.Uuid
  principalId String   @map("principal_id") @db.Text
  token       String   @db.Text
  platform    String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([principalId, token])
  @@index([principalId, active])
  @@map("push_tokens")
  @@schema("realtime")
}
