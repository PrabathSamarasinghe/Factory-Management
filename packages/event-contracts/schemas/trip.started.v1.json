{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.galatura.local/events/trip.started.v1.json",
  "title": "trip.started payload v1",
  "$comment": "Payload only. Wrapped by event-envelope.v1.json. Decimals are strings to avoid float rounding.",
  "type": "object",
  "required": ["tripId", "routeId", "lorryId", "ownerPersonId", "startedAt", "startOdometerKm"],
  "properties": {
    "tripId": { "type": "string", "format": "uuid" },
    "routeId": { "type": "string", "format": "uuid" },
    "lorryId": { "type": "string", "format": "uuid" },
    "routeAssignmentId": { "type": ["string", "null"], "format": "uuid" },
    "driverId": { "type": ["string", "null"], "format": "uuid" },
    "helperId": { "type": ["string", "null"], "format": "uuid" },
    "supervisorId": { "type": ["string", "null"], "format": "uuid" },
    "ownerPersonId": { "type": "string", "format": "uuid" },
    "startedAt": { "type": "string", "format": "date-time" },
    "startOdometerKm": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,1})?$"
    }
  }
}
