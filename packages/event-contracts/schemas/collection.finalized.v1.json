{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.galatura.local/events/collection.finalized.v1.json",
  "title": "collection.finalized payload v1",
  "$comment": "Payload only. Wrapped by event-envelope.v1.json. Decimals are strings to avoid float rounding.",
  "type": "object",
  "required": [
    "tripId",
    "supplierId",
    "collectionDate",
    "totalNetKg",
    "totalBags",
    "finalizedAt",
    "finalizedBy"
  ],
  "properties": {
    "dailyTotalId": { "type": "string", "format": "uuid" },
    "tripId": { "type": "string", "format": "uuid" },
    "supplierId": { "type": "string", "format": "uuid" },
    "collectionDate": { "type": "string", "format": "date" },
    "totalNetKg": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$"
    },
    "totalBags": { "type": "integer", "minimum": 0 },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "finalizedBy": { "type": "string", "format": "uuid" }
  }
}
