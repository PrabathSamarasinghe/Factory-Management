{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.galatura.local/events/inventory.purchase.received.v1.json",
  "title": "inventory.purchase.received payload v1",
  "$comment": "Payload only. Wrapped by event-envelope.v1.json. Identifiers, account codes and decimal strings only; never PII, bank details or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "vendorId",
    "receivedDate",
    "reference",
    "lines",
    "totalValue",
    "approvedBy",
    "approvedAt"
  ],
  "properties": {
    "receiptId": { "type": "string", "format": "uuid" },
    "vendorId": { "type": "string", "format": "uuid" },
    "receivedDate": { "type": "string", "format": "date" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 100 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "qty",
          "unitCost",
          "value",
          "inventoryAccountCode",
          "payableAccountCode"
        ],
        "properties": {
          "itemId": { "type": "string", "format": "uuid" },
          "qty": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "unitCost": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "value": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "inventoryAccountCode": { "type": "string", "minLength": 1, "maxLength": 40 },
          "payableAccountCode": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "totalValue": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
    "approvedBy": { "type": "string", "format": "uuid" },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
