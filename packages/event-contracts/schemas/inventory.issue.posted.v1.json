{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.galatura.local/events/inventory.issue.posted.v1.json",
  "title": "inventory.issue.posted payload v1",
  "$comment": "Payload only. Wrapped by event-envelope.v1.json. Identifiers, account codes and decimal strings only; never PII, bank details or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issueId",
    "issueDate",
    "issuedToType",
    "issuedToId",
    "purpose",
    "lines",
    "totalValue",
    "approvedBy",
    "approvedAt"
  ],
  "properties": {
    "issueId": { "type": "string", "format": "uuid" },
    "issueDate": { "type": "string", "format": "date" },
    "issuedToType": { "type": "string", "minLength": 1, "maxLength": 40 },
    "issuedToId": { "type": "string", "format": "uuid" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "qty",
          "unitCost",
          "value",
          "expenseAccountCode",
          "inventoryAccountCode"
        ],
        "properties": {
          "itemId": { "type": "string", "format": "uuid" },
          "qty": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "unitCost": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "value": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "expenseAccountCode": { "type": "string", "minLength": 1, "maxLength": 40 },
          "inventoryAccountCode": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "totalValue": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
    "approvedBy": { "type": "string", "format": "uuid" },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
