# Gateway env template for development/testing on Render.
# Fill these values in the Render dashboard or in a local ignored .env file.
# Do not put real secrets in this template.
# Render supplies PORT; leave it unset here.

APP_ENV=dev
NODE_ENV=production
LOG_LEVEL=debug

IDENTITY_JWKS_URI="https://<identity-service-host>/.well-known/jwks.json"

IDENTITY_SERVICE_URL="https://<identity-service-host>"
PEOPLE_SERVICE_URL="https://<people-service-host>"
ATTENDANCE_SERVICE_URL="https://<attendance-service-host>"
FLEET_SERVICE_URL="https://<fleet-service-host>"
COLLECTION_SERVICE_URL="https://<collection-service-host>"
NOTIFICATION_SERVICE_URL="https://<notification-service-host>"
REALTIME_SERVICE_URL="https://<realtime-service-host>"
ACCOUNTS_SERVICE_URL="https://<accounts-service-host>"
INVENTORY_SERVICE_URL="https://<inventory-service-host>"
REPORTING_SERVICE_URL="https://<reporting-service-host>"

REDIS_URL=""
